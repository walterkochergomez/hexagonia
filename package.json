{
  "name": "hexagonia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Juego de colonización y comercio en hexágonos para jugar en línea con amigos, sin servidor.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/rules.test.ts",
    "test:watch": "vitest",
    "sim": "vitest run tests/sim.test.ts",
    "e2e": "node e2e/run.mjs",
    "typecheck": "tsc -b --noEmit",
    "e2e:soak": "node e2e/soak.mjs",
    "e2e:a11y": "node e2e/a11y.mjs",
    "e2e:fit": "tsx scripts/make-rooms.ts && node e2e/fit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "peer": "^1.0.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
